// Hunter's Workshop 0.4.4 beta 21: the scene colour's last row and column replaced by the texels
// inside them, in RGB only, before the upscaler reads the scene (TemporalUpscaler::Run; with
// jitter the game's passes leave that edge brighter in some phases, GitHub issue 43). The two
// image copies this replaces moved whole texels, so the merge, which keeps the scene's alpha,
// kept the neighbour's alpha there (the engine map's upscale-5). Here the alpha stays as the game
// wrote it. One invocation per edge texel: the last row (the corner included), then the last
// column above it.
#version 450

layout(local_size_x = 64) in;

layout(binding = 0, rgba16f) uniform image2D scene;

layout(push_constant) uniform Params {
    uint width; // the scene's size, from the image's top left (the image may be larger)
    uint height;
};

void main() {
    const uint i = gl_GlobalInvocationID.x;
    ivec2 pixel;
    if (i < width) {
        pixel = ivec2(i, height - 1);
    } else if (i < width + height - 1) {
        pixel = ivec2(width - 1, i - width);
    } else {
        return;
    }
    // As the copies did: the row from the row above it, then the column from the column before
    // it, so the corner from the texel diagonally inside it. No source is an edge texel, so no
    // invocation reads what another writes.
    const ivec2 source = min(pixel, ivec2(width, height) - 2);
    const float alpha = imageLoad(scene, pixel).a;
    imageStore(scene, pixel, vec4(imageLoad(scene, source).rgb, alpha));
}
