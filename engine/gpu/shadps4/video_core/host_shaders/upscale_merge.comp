// bbport: writes the upscaler's color back into the game's scene color, keeping the game's alpha
// (post-processing reads data from it). Debug modes: 1 shows the reactive mask in red,
// 2 the motion vectors given to the upscaler (red/green: |x|/|y|, 8 render pixels = full;
// blue: the pixel has an object motion vector from its vertices, not camera motion). The debug
// views see the sharpened colour, as when the sharpening was a pass before this one.
#version 450
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform readonly image2D upscaled;
layout(binding = 1, rgba16f) uniform image2D scene;
layout(binding = 2, r8) uniform readonly image2D reactive;
layout(binding = 3) uniform texture2D motion;  // render size, pixels
// Render size, R32G32_UINT: y's sign bit = object vector written (0.4.4 beta 15). Bound only
// with mode bit 4; otherwise the motion image stands in and is not read.
layout(binding = 4) uniform utexture2D objects;

layout(push_constant) uniform Params {
    uint mode;
    // 0.4.4 beta 20: the port's extra sharpening done here (0: none), as taa_sharpen.comp would
    // before the merge, without its RGBA32F copy and pass (rcas_extra.glsl).
    float sharpen;
};

#define RCAS_SOURCE upscaled
#include "rcas_extra.glsl"

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(scene)))) {
        return;
    }
    const vec4 original = imageLoad(scene, pixel);
    vec3 color = sharpen > 0.0 ? ExtraSharpen(pixel, sharpen) : imageLoad(upscaled, pixel).rgb;
    const uint view = mode & 3u;
    if (view == 1) {
        const float mask = imageLoad(reactive, min(pixel * imageSize(reactive) / imageSize(scene), imageSize(reactive) - 1)).r;
        color = mix(color * 0.25, vec3(4.0, 0.0, 0.0), mask);
    } else if (view == 2) {
        const ivec2 size = textureSize(motion, 0);
        const ivec2 source = min(pixel * size / imageSize(scene), size - 1);
        const vec2 mv = texelFetch(motion, source, 0).rg;
        const ivec2 object_size = textureSize(objects, 0);
        const bool object = (mode & 4u) != 0u && object_size == size &&
                             (texelFetch(objects, source, 0).y & 0x80000000u) != 0u;
        const float luma = dot(min(color, vec3(1.0)), vec3(0.3, 0.6, 0.1));
        color = vec3(luma * 0.3) + vec3(clamp(abs(mv) / 8.0, 0.0, 1.0), object ? 0.6 : 0.0);
    }
    imageStore(scene, pixel, vec4(color, original.a));
}
